# Required: session encryption key. Generate one with `openssl rand -hex 32`.
# 必填：会话加密密钥，用 `openssl rand -hex 32` 生成
SECRET_KEY=change-me-to-a-long-random-string

# Login credentials. Pick one of the two: a plaintext APP_PASSWORD, or a
# pre-generated APP_PASSWORD_HASH.
#
# 登录凭据（二选一：APP_PASSWORD 明文，或 APP_PASSWORD_HASH 预生成哈希）
APP_USER=admin
APP_PASSWORD=change-me
# APP_PASSWORD_HASH=scrypt:32768:8:1$...

# Language for output that has no browser to detect: container startup messages,
# and requests without an Accept-Language header (curl, cron). It is also the
# last resort for the web UI. `en` or `zh-CN`.
#
# 没有浏览器可探测时的输出语言：容器启动消息，以及不带 Accept-Language 的
# 请求（curl、cron）。同时也是网页的保底语言。取值 `en` 或 `zh-CN`。
APP_LANG=en

# Set to 1 when the app is served over HTTPS: the session and language cookies
# are then marked Secure and never sent in the clear. Leave 0 for plain HTTP
# on a LAN, otherwise logging in will not work.
#
# 走 HTTPS 时置 1，会话与语言 cookie 会带上 Secure，不会明文传输。
# 局域网走明文 HTTP 时保持 0，否则登录会失败。
COOKIE_SECURE=0

# Default wake mode: key / signal / both.
# 默认唤醒方式：key（仅按键）/ signal（仅唤醒信号）/ both（信号+按键）
WAKE_MODE=both
WAKE_KEY=enter
WAKE_REPEAT=1
KEY_HOLD_MS=60

# HID device node and gadget name. Must match host/setup-hid-gadget.sh.
# HID 设备节点与 gadget 名（与 host/setup-hid-gadget.sh 保持一致）
HID_DEVICE=/dev/hidg0
GADGET_NAME=hidwake

# Set to 1 to let signal mode fall back to UDC rebinding when the kernel lacks
# the patch. Also uncomment the /sys/kernel/config volume in docker-compose.yml.
#
# 置 1 后 signal 模式在无内核补丁时改用 UDC 重绑定；
# 需要同时取消 docker-compose.yml 里 /sys/kernel/config 那行注释
ENABLE_UDC_REBIND=0
